begin transaction;
create schema project;
set search_path to project;

-- User table --
create table users (
	id serial primary key,
	name varchar(20) not null check (name <> ''),
	type text not null check (type in ('annonceur', 'acheteur', 'expert'))
);

-- Product table --
create table products (
	id serial primary key,
	title varchar(40) not null check (title <> ''),
	description varchar(500),
	state text not null check (state in ('new', 'like new', 'used', 'as is')),
	status text not null check (status in ('active', 'sold')),
	category text not null check (category in ('cars', 'real estate', 'pets', 'services')),
	wanted_price numeric not null check (wanted_price > 0 AND wanted_price = ROUND(wanted_price, 2)),
	announcer_id int not null,
	foreign key (announcer_id) references users(id)
);

-- Offer table --
create table offer (
	id serial primary key,
	price numeric not null check (price > 0 AND price = ROUND(price, 2)),
	status text not null check (status in ('accepted', 'declined')),
	message varchar(100),
	user_id int not null,
	foreign key (user_id) references users(id),
	product_id int not null,
	foreign key (product_id) references products(id)
);

-- Estimation table --
create table estimation (
	id serial primary key,
	estimate numeric not null check (estimate > 0 AND estimate = ROUND(estimate, 2)),
	decision boolean not null,
	expert_id int not null,
	foreign key (expert_id) references users(id),
	product_id int not null,
	foreign key (product_id) references products(id)
);

commit;
